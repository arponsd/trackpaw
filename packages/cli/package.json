{
  "name": "@trackpaw/cli",
  "version": "0.1.2",
  "description": "CLI tool to install and configure Trackpaw analytics in seconds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arponsd/trackpaw.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/arponsd/trackpaw/tree/main/packages/cli#readme",
  "bugs": "https://github.com/arponsd/trackpaw/issues",
  "bin": {
    "trackpaw": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md"],
  "keywords": [
    "trackpaw",
    "analytics",
    "cli",
    "self-hosted",
    "setup"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
